/* Generated by wallust — rofi-bluetooth */

@import "~/.cache/wallust/colors-rofi.rasi"

* {
    /* Base */
    BG:     @background;
    FG:     @foreground;
    BDR:    @border-color;

    /* States */
    SEL:    @selected-normal-background;
    BGA:    @active-background;
    UGT:    @urgent-background;

    /* Accent / icon */
    IMG:    @active-background;
}

