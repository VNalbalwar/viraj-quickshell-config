#!/bin/sh
# qs-hotspot-iface add|del
# Creates / removes ONE virtual access-point interface ("qsap0") on the same
# Wi-Fi radio as wlan0, so a hotspot can run next to your normal Wi-Fi
# connection (Intel cards allow 1 station + 1 AP, on the SAME channel).
# It never touches wlan0 itself and accepts no other input, so the polkit rule
# that allows it can't be abused for anything else.
set -eu

PARENT=wlan0
AP=qsap0

case "${1:-}" in
    add)
        ip link show "$AP" >/dev/null 2>&1 && exit 0          # already there
        phy=$(iw dev "$PARENT" info | awk '/wiphy/ {print "phy" $2; exit}')
        [ -n "$phy" ] || { echo "qs-hotspot-iface: no radio found for $PARENT" >&2; exit 1; }
        iw phy "$phy" interface add "$AP" type __ap
        ;;
    del)
        ip link show "$AP" >/dev/null 2>&1 || exit 0
        ip link set "$AP" down 2>/dev/null || true
        iw dev "$AP" del
        ;;
    *)
        echo "usage: qs-hotspot-iface add|del" >&2
        exit 2
        ;;
esac
