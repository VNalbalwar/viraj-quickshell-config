#!/bin/bash
# qs-hotspot start <ssid> <password> <channel> <g|a>  |  qs-hotspot stop
#
# Runs a Wi-Fi hotspot NEXT TO your normal Wi-Fi connection.
# Intel radios allow 1 station + 1 access point at once, but only on the SAME
# channel, and NetworkManager can't drive that (it puts the AP on wlan0 itself,
# dropping your connection, and refuses a second interface). So: a virtual AP
# interface (qsap0) + hostapd + dnsmasq (DHCP/DNS) + NAT, all owned here.
# wlan0 is never touched. Every argument is validated before anything runs,
# because the polkit rule lets the desktop user call this without a password.
set -euo pipefail

PARENT=wlan0
AP=qsap0
NET=192.168.77
RUN=/run/qs-hotspot

fw_clean() {
    nft delete table inet qs_hotspot 2>/dev/null || true
    nft delete table ip qs_hotspot_nat 2>/dev/null || true
    # Docker sets FORWARD policy to DROP through iptables; undo our accepts there too
    iptables -D FORWARD -i "$AP" -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -o "$AP" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
}

stop() {
    for svc in dnsmasq hostapd; do
        if [ -f "$RUN/$svc.pid" ]; then
            kill "$(cat "$RUN/$svc.pid")" 2>/dev/null || true
            rm -f "$RUN/$svc.pid"
        fi
    done
    fw_clean
    if ip link show "$AP" >/dev/null 2>&1; then
        ip addr flush dev "$AP" 2>/dev/null || true
        ip link set "$AP" down 2>/dev/null || true
        iw dev "$AP" del || true
    fi
    rm -f "$RUN/hostapd.conf"
}

case "${1:-}" in
    stop)
        stop
        ;;

    start)
        ssid="${2:-}"; pass="${3:-}"; chan="${4:-}"; band="${5:-}"

        [[ "$ssid" =~ ^[A-Za-z0-9._\ -]{1,32}$ ]]   || { echo "bad ssid" >&2; exit 2; }
        [[ "$pass" =~ ^[A-Za-z0-9._-]{8,63}$ ]]      || { echo "bad password" >&2; exit 2; }
        [[ "$chan" =~ ^[0-9]{1,3}$ ]]               || { echo "bad channel" >&2; exit 2; }
        [ "$band" = g ] || [ "$band" = a ]          || { echo "bad band" >&2; exit 2; }
        if [ "$band" = g ]; then [ "$chan" -ge 1 ] && [ "$chan" -le 13 ]; else [ "$chan" -ge 36 ] && [ "$chan" -le 165 ]; fi \
            || { echo "channel outside band" >&2; exit 2; }

        stop                                   # always start from a clean slate
        mkdir -p "$RUN"; chmod 700 "$RUN"

        # 1. virtual AP interface on the same radio as wlan0
        phy=$(iw dev "$PARENT" info | awk '/wiphy/ {print "phy" $2; exit}')
        [ -n "$phy" ] || { echo "no radio for $PARENT" >&2; exit 1; }
        iw phy "$phy" interface add "$AP" type __ap
        nmcli device set "$AP" managed no 2>/dev/null || true      # keep NetworkManager out of it

        # 2. hostapd on wlan0's channel (same channel is what lets both run together)
        {
            echo "interface=$AP"
            echo "driver=nl80211"
            echo "ssid=$ssid"
            echo "hw_mode=$band"
            echo "channel=$chan"
            echo "ieee80211n=1"
            [ "$band" = a ] && echo "ieee80211ac=1"
            echo "wmm_enabled=1"
            echo "auth_algs=1"
            echo "wpa=2"
            echo "wpa_key_mgmt=WPA-PSK"
            echo "rsn_pairwise=CCMP"
            echo "wpa_passphrase=$pass"
        } > "$RUN/hostapd.conf"
        chmod 600 "$RUN/hostapd.conf"

        if ! hostapd -B -P "$RUN/hostapd.pid" "$RUN/hostapd.conf" >"$RUN/hostapd.log" 2>&1; then
            cat "$RUN/hostapd.log" >&2
            stop
            exit 1
        fi

        # 3. addressing + DHCP/DNS for the devices that join
        ip addr add "$NET.1/24" dev "$AP"
        ip link set "$AP" up
        dnsmasq --pid-file="$RUN/dnsmasq.pid" --conf-file=/dev/null \
            --interface="$AP" --listen-address="$NET.1" --bind-interfaces \
            --dhcp-range="$NET.10,$NET.100,255.255.255.0,12h" \
            --dhcp-option=3,"$NET.1" --dhcp-option=6,"$NET.1" \
            --no-resolv --server=1.1.1.1 --server=8.8.8.8 --no-hosts

        # 4. NAT + forwarding (nft for us, iptables because Docker's FORWARD policy is DROP)
        sysctl -qw net.ipv4.ip_forward=1
        nft -f - <<EOF
table inet qs_hotspot {
    chain forward {
        type filter hook forward priority -10; policy accept;
        iifname "$AP" accept
        oifname "$AP" ct state established,related accept
    }
}
table ip qs_hotspot_nat {
    chain postrouting {
        type nat hook postrouting priority 100; policy accept;
        ip saddr $NET.0/24 oifname != "$AP" masquerade
    }
}
EOF
        iptables -I FORWARD -i "$AP" -j ACCEPT 2>/dev/null || true
        iptables -I FORWARD -o "$AP" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
        ;;

    *)
        echo "usage: qs-hotspot start <ssid> <password> <channel> <g|a> | stop" >&2
        exit 2
        ;;
esac
