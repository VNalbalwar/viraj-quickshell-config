#!/usr/bin/env python3
"""Native-messaging helper between the "Notch tab bridge" Chrome extension and the Quickshell notch.

Chrome starts this and talks to it over stdin/stdout (4-byte little-endian length + JSON).
  Chrome -> here : {"type": "tabs", "browser": ..., "tabs": [...]}   written to  $XDG_RUNTIME_DIR/qs-chrome/tabs.json
  here -> Chrome : {"cmd": "mute|pause|play|focus", "tabId": N, ...}  taken from a private unix socket
                   $XDG_RUNTIME_DIR/qs-chrome/cmd.sock (written by qs-chrome-ctl, which the notch runs)

Nothing here is reachable from the network: the directory is 0700 and the socket is a local file."""
import json
import os
import socket
import struct
import sys
import threading

RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "qs-chrome")
TABS = os.path.join(RUN, "tabs.json")
SOCK = os.path.join(RUN, "cmd.sock")
ALLOWED = {"mute", "pause", "play", "focus"}

os.makedirs(RUN, mode=0o700, exist_ok=True)
os.chmod(RUN, 0o700)

out_lock = threading.Lock()


def to_chrome(obj):
    data = json.dumps(obj).encode()
    with out_lock:
        sys.stdout.buffer.write(struct.pack("<I", len(data)) + data)
        sys.stdout.buffer.flush()


def write_tabs(payload):
    tmp = TABS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(payload, f)
    os.replace(tmp, TABS)             # atomic: the notch never reads a half-written file


def serve_commands():
    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o600)
    srv.listen(8)
    while True:
        conn, _ = srv.accept()
        try:
            line = conn.makefile().readline()
            cmd = json.loads(line)
            if (cmd.get("cmd") in ALLOWED and isinstance(cmd.get("tabId"), int)
                    and (cmd["cmd"] != "mute" or isinstance(cmd.get("muted"), bool))):
                to_chrome({k: cmd[k] for k in ("cmd", "tabId", "muted") if k in cmd})
        except Exception:
            pass                      # ignore malformed requests
        finally:
            conn.close()


def main():
    threading.Thread(target=serve_commands, daemon=True).start()
    stdin = sys.stdin.buffer
    try:
        while True:
            header = stdin.read(4)
            if len(header) < 4:
                break                 # Chrome closed the pipe
            (length,) = struct.unpack("<I", header)
            msg = json.loads(stdin.read(length))
            if msg.get("type") == "tabs":
                write_tabs({"browser": msg.get("browser", "Chrome"), "tabs": msg.get("tabs", [])})
    finally:
        try:                          # Chrome went away: nothing is playing through it any more
            write_tabs({"browser": "", "tabs": []})
            os.unlink(SOCK)
        except OSError:
            pass


if __name__ == "__main__":
    main()
