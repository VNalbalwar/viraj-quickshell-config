#!/usr/bin/env python3
"""Send one command to the running Chrome tab bridge (used by the Quickshell notch).
   qs-chrome-ctl mute <tabId> true|false
   qs-chrome-ctl pause|play|focus <tabId>"""
import json
import os
import socket
import sys

SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "qs-chrome", "cmd.sock")

if len(sys.argv) < 3:
    sys.exit("usage: qs-chrome-ctl mute <tabId> true|false | pause|play|focus <tabId>")

cmd = {"cmd": sys.argv[1], "tabId": int(sys.argv[2])}
if sys.argv[1] == "mute":
    cmd["muted"] = (sys.argv[3] if len(sys.argv) > 3 else "true").lower() == "true"

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(3)
s.connect(SOCK)
s.sendall((json.dumps(cmd) + "\n").encode())
s.close()
