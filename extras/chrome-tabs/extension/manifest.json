{
  "manifest_version": 3,
  "name": "Notch tab bridge",
  "version": "1.0.0",
  "description": "Tells the Quickshell notch which tabs are playing sound and lets it mute, pause or focus them.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
